{
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",

  "name": "unpkg-files",
  "observability": { "enabled": true, "head_sampling_rate": 0.001 },
  "routes": [{ "pattern": "files.unpkg.com", "custom_domain": true }],
  "vars": {
    "DEV": false,
    "MODE": "production",
    "ORIGIN": "https://files.unpkg.com"
  },

  "env": {
    "dev": {
      "name": "unpkg-files-dev",
      "routes": [],
      "vars": {
        "DEV": true,
        "MODE": "development",
        "ORIGIN": "http://localhost:4000"
      }
    },

    "staging": {
      "name": "unpkg-files-staging",
      "observability": { "enabled": true },
      "routes": [{ "pattern": "files.unpkg.dev", "custom_domain": true }],
      "vars": {
        "DEV": false,
        "MODE": "staging",
        "ORIGIN": "https://files.unpkg.dev"
      }
    }
  }
}
